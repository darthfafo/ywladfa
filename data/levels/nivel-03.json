        "tutorial": "tut_n3_rancho"
      }
    },
    {
      "id": "trig_n3_rancho_hecho",
      "type": "dialogue",
      "requires": "flags.n3_tiene_rancho == true && flags.n3_crecida != true",
      "once": true,
      "turnCost": 0,
      "action": {
        "dialogue": "d_n3_rancho_hecho"
      }
    },
    {
      "id": "trig_n3_viveres",
      "type": "cutscene",
      "requires": "progress.day >= 2 && flags.n3_bandera == true",
      "once": true,
      "turnCost": 0,
      "note": "Los víveres del gobierno llegaban de forma irregular (docs/04 §1.3). Este envío puntual es dramatizado.",
      "action": {
        "dialogue": "d_n3_viveres"
      }
    },
    {
      "id": "trig_n3_viveres_reparto",
      "type": "choice",
      "requires": "flags.n3_viveres_llegaron == true",
      "once": true,
      "turnCost": 0,
      "action": {
        "choice": "ch_n3_viveres"
      }
    },
    {
      "id": "trig_n3_crecida",
      "type": "cutscene",
      "requires": "progress.day >= 3 && flags.n3_bandera == true",
      "once": true,
      "turnCost": 0,
      "note": "la crecida de 1865: el guion (src/levels/nivel03.ts) baja el agua sobre lo construido al disparar este trigger, antes del diálogo",
      "action": {
        "dialogue": "d_n3_crecida"
      }
    },
    {
      "id": "trig_n3_rehacer",
      "type": "choice",
      "requires": "flags.n3_crecida_vista == true",
      "once": true,
      "turnCost": 1,
      "action": {
        "choice": "ch_n3_rehacer"
      }
    },
    {
      "id": "trig_n3_acto1_fin",
      "type": "cutscene",
      "requires": "flags.n3_rehacer != null && (flags.n3_tiene_rancho == true || progress.day >= 5) && (flags.n3_rehacer != 'corral' || flags.n3_tiene_corral == true || progress.day >= 5)",
      "once": true,
      "turnCost": 0,
      "action": {
        "dialogue": "d_n3_acto1_fin"
      }
    },
    {
      "id": "trig_n3_invierno",
      "type": "cutscene",
      "requires": "flags.n3_acto1 == true",
      "once": true,
      "turnCost": 4,
      "note": "salto de tiempo: el verano de 1865-66 y la cosecha perdida (docs/04 §1.3). El guion pone la comida del invierno al cerrarse el diálogo (balance nivel03.invierno + el depósito).",
      "action": {
        "dialogue": "d_n3_invierno"
      }
    },
    {
      "id": "trig_n3_gwilym_aviso",
      "type": "cutscene",
      "requires": "flags.n3_invierno == true && flags.n3_sin_harina == true",
      "once": true,
      "turnCost": 0,
      "note": "la promesa de la harina (items.json): primera muerte posible, con dos jornadas de aviso (GDD §5.4) y evitable. Gwilym es ficticio (D5).",
      "action": {
        "dialogue": "d_n3_gwilym_aviso"
      }
    },
    {
      "id": "trig_n3_toldo",
      "type": "cutscene",
      "requires": "flags.n3_invierno == true",
      "once": true,
      "turnCost": 0,
      "note": "abril de 1866: cuatro personas arman un toldo junto al fuerte (docs/04 §1.3). El guion pone el toldo en el mapa con n3_toldo.",
      "action": {
        "dialogue": "d_n3_toldo"
      }
    },
    {
      "id": "trig_n3_pan",
      "type": "choice",
      "requires": "flags.n3_toldo_visto == true",
      "once": true,
      "turnCost": 0,
      "action": {
        "choice": "ch_n3_pan"
      }
    },
    {
      "id": "trig_n3_manta",
      "type": "dialogue",
      "manual": true,
      "requires": "flags.n3_pan != null",
      "once": true,
      "turnCost": 1,
      "note": "D4: el trato es una escena guionada sobre la manta; el trueque como sistema es del Nivel 7",
      "action": {
        "dialogue": "d_n3_manta"
      }
    },
    {
      "id": "trig_n3_gwilym_comida",
      "type": "choice",
      "requires": "flags.n3_gwilym_enfermo == true && flags.n3_trato != null",
      "once": true,
      "turnCost": 0,
      "action": {
        "choice": "ch_n3_gwilym"
      }
    },
    {
      "id": "trig_n3_recaida",
      "type": "cutscene",
      "requires": "flags.n3_trato != null && flags.n3_sin_abrigo == true && (flags.n3_sin_harina != true || flags.n3_gwilym != null)",
      "once": true,
      "turnCost": 0,
      "note": "la promesa del abrigo (items.json): enfermedad recurrente desde el Nivel 2",
      "action": {
        "dialogue": "d_n3_recaida"
      }
    },
    {
      "id": "trig_n3_cuidar",
      "type": "choice",
      "requires": "flags.n3_recaida_vista == true",
      "once": true,
      "turnCost": 0,
      "action": {
        "choice": "ch_n3_cuidar"
      }
    },
    {
      "id": "trig_n3_gwilym_fin",
      "type": "cutscene",
      "requires": "flags.n3_gwilym != null && (flags.n3_sin_abrigo != true || flags.n3_cuidado != null)",
      "once": true,
      "turnCost": 8,
      "note": "dos jornadas después del aviso (turnCost 8 = dos días)",
      "action": {
        "dialogue": "d_n3_gwilym_fin"
      }
    },
    {
      "id": "trig_n3_acto2_fin",
      "type": "cutscene",
      "requires": "flags.n3_trato != null && (flags.n3_sin_abrigo != true || flags.n3_cuidado != null) && (flags.n3_sin_harina != true || flags.n3_gwilym_fin == true)",
      "once": true,
      "turnCost": 4,
      "action": {
        "dialogue": "d_n3_acto2_fin"
      }
    },
    {
      "id": "trig_gwilym_charla",
      "type": "dialogue",
      "manual": true,
      "requires": "flags.n3_gwilym_murio != true",
      "once": false,
      "turnCost": 0,
      "action": {
        "dialogue": "d_n3_gwilym_charla"
      }
    }
  ],
