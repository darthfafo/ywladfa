  "objectives": [],
  "goals": [
    {
      "requires": "flags.n3_acto2 == true",
      "text": "Lo que sigue —1867, la zanja— está en armado."
    },
    {
      "requires": "flags.n3_acto1 == true && flags.n3_toldo != true",
      "text": "Aguantar el invierno."
    },
    {
      "requires": "flags.n3_toldo == true && flags.n3_trato == null",
      "text": "Ir al toldo, junto al fuerte. Llevar algo para la manta."
    },
    {
      "requires": "flags.n3_gwilym_enfermo == true && flags.n3_gwilym == null",
      "text": "Gwilym, el de los vecinos, necesita comer."
    },
    {
      "requires": "flags.n3_acto2 != true && flags.n3_acto1 == true",
      "text": "Cuidar a los tuyos hasta que pase el frío."
    },
    {
      "requires": "flags.n3_bandera != true",
      "text": "Ir al fuerte viejo: el comandante junta a todos."
    },
    {
      "requires": "flags.n3_tiene_rancho != true && flags.n3_crecida != true",
      "text": "Juntar barro y junco en la orilla y levantar el rancho. ¿Cerca del río o en la barda?"
    },
    {
      "requires": "flags.n3_crecida != true",
      "text": "Esperar. El río está alto."
    },
    {
      "requires": "flags.n3_rehacer == null",
      "text": "Ver qué dejó la crecida."
    },
    {
      "requires": "flags.n3_rehacer == 'corral' && flags.n3_tiene_corral != true",
      "text": "Levantar el corral de todos: barro, junco y palos."
    },
    {
      "requires": "flags.n3_tiene_rancho != true",
      "text": "Rehacer el rancho, más arriba."
    },
    {
      "text": "El rancho está en pie."
    }
  ],
  "triggers": [
    {
      "id": "trig_n3_bandera",
      "type": "cutscene",
      "requires": "progress.day == 1",
