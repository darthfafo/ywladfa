{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quests de un nivel",
  "type": "object",
  "required": [
    "level",
    "quests"
  ],
  "properties": {
    "level": {
      "type": "string"
    },
    "quests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "day",
          "optional",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^q_[a-z0-9_]+$"
          },
          "title": {
            "type": "string"
          },
          "day": {
            "type": "integer",
            "minimum": 1
          },
          "optional": {
            "type": "boolean"
          },
          "journalLine": {
            "type": "string"
          },
          "journalLineIfSuccess": {
            "type": "string"
          },
          "journalLineIfFail": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "trigger": {
                  "type": "string"
                },
                "requires": {
                  "type": "string"
                },
                "counter": {
                  "type": "object"
                },
                "hints": {
                  "type": "array"
                }
              }
            }
          },
          "failSoft": {
            "type": "object",
            "description": "El nivel nunca se pierde: define qué pasa si el jugador no lo logra"
          },
          "rewards": {
            "type": "array"
          },
          "irreversible": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          },
          "onComplete": {
            "type": "object"
          }
        }
      }
    }
  }
}
