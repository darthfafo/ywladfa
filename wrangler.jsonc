{
  // Deploy de solo assets estáticos: sin "main" (no hay Worker corriendo código,
  // ver docs.md — es un juego cliente-only). "npm run build" ya deja todo listo
  // en dist/, esto solo le dice a `wrangler deploy` qué carpeta subir.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ywladfa",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
